# Ignorar pastas inteiras de instaladores extraídos
Executaveis/Adobe/*
!Executaveis/Adobe/LEIA-ME.txt
Executaveis/Office2021/Office/
Executaveis/Office2021/ProPlus2021Retail.img

# Compatibilidade com acento (caso alguém crie localmente)
