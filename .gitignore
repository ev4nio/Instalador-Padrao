Executaveis/**/*.msi
Executaveis/**/*.msp
Executaveis/**/*.iso
Executaveis/**/*.img
Executaveis/**/*.download
Executaveis/**/*.cab
Executaveis/**/*.c2rx
Executaveis/**/*.cat
Executaveis/**/*.dll
Executaveis/**/*.dat
Executaveis/**/*.bmp
Executaveis/**/*.nfo
Executaveis/**/*.inf
Executaveis/**/*.mst
Executaveis/**/*.ini
Executaveis/**/*.htm
Executaveis/**/*.html
